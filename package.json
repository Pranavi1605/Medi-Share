{
  "name": "medishare",
  "version": "1.0.0",
  "description": "MediShare - Unified Healthcare & Diagnostic Platform",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "node run-all.js",
    "start": "node server/server.js",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "seed": "node server/seed.js",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": [
    "healthcare",
    "hospital",
    "react",
    "express",
    "mongodb",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1"
  }
}
